# Nix system-manager configuration for {{ inventory_hostname }}
# Generated by Ansible nix-bootstrap role
# DO NOT EDIT MANUALLY on the node - Changes will be overwritten
#
# To make changes:
# 1. Edit roles/nix-bootstrap/templates/configuration.nix.j2 in this repository
# 2. Re-run: make bootstrap-nix NODE={{ inventory_hostname }}
# 3. Or manually edit /etc/nix-system/configuration.nix and run:
#    cd /etc/nix-system && sudo system-manager switch --flake .
#
# Configuration Version: 2.1 (Phase 1 - iscsid reverted to system management)
# Last Updated: 2026-02-16

{ config, pkgs, lib, ... }:

{
  config = {
    # =========================================================================
    # SYSTEM CONFIGURATION
    # =========================================================================

    # Allow running on Debian (and other non-Ubuntu/NixOS distributions)
    system-manager.allowAnyDistro = true;

    # System architecture
    nixpkgs.hostPlatform = "{{ 'aarch64-linux' if ansible_architecture == 'aarch64' else 'x86_64-linux' }}";

    # Enable experimental features for flakes
    nix.extraOptions = ''
      experimental-features = nix-command flakes
    '';

    # Note: Timezone managed by host OS (Ansible roles/system/tasks/main.yml)
    # system-manager doesn't support timezone configuration (NixOS-only feature)

    # =========================================================================
    # SYSTEM PACKAGES
    # =========================================================================
    # All packages required for k3s operation and system administration
    # Replaces: roles/system/tasks/packages.yml (partially)

    environment.systemPackages = with pkgs; [
      # === Kubernetes ===
      k3s_1_32              # Pin to v1.32.x to match cluster version (includes kubectl)

      # === Core Utilities ===
      curl                  # HTTP client
      git                   # Version control
      wget                  # File download utility
      rsync                 # File synchronization

      # === System Monitoring ===
      htop                  # Interactive process viewer
      iotop                 # I/O monitoring
      iftop                 # Network bandwidth monitoring

      # === Text Editors ===
      vim                   # Vi improved
      neovim                # Modern vim fork

      # === Terminal Utilities ===
      tmux                  # Terminal multiplexer
      mosh                  # Mobile shell (survives network interruptions)
      ripgrep               # Fast grep alternative

      # === Network Tools ===
      iputils               # ping, traceroute, etc.
      bind.dnsutils         # dig, nslookup, etc.
      netcat                # Network debugging

      # === Storage/Block Device Tools ===
      nfs-utils             # NFS client for network storage
      openiscsi             # iSCSI initiator for SAN/block storage
      multipath-tools       # Device mapper multipath support
      lsscsi                # List SCSI devices

      # === System Info ===
      lsb-release           # Linux Standard Base version info
      pciutils              # lspci
      usbutils              # lsusb
    ];

    # =========================================================================
    # STATIC CONFIGURATION FILES
    # =========================================================================
    # Declaratively manage static configuration files
    # Replaces: roles/system/files/etc/multipath.conf

    environment.etc = {
      # Multipath device mapper configuration
      "multipath.conf" = {
        mode = "0644";
        text = ''
          defaults {
              user_friendly_names yes
              find_multipaths yes
          }
        '';
      };
    };

    # =========================================================================
    # STORAGE SERVICES
    # =========================================================================
    # Services required for k3s persistent volume support
    # Replaces: roles/system/tasks/packages.yml (storage block)

    # Multipath device mapper daemon
    # Provides multipath I/O support for SAN/block storage
    systemd.services.multipathd = {
      description = "Device-Mapper Multipath Device Controller";
      documentation = [ "man:multipathd(8)" ];
      wantedBy = [ "multi-user.target" ];
      before = [ {% if 'master' in group_names %}"k3s.service"{% else %}"k3s-agent.service"{% endif %} ];
      wants = [ "systemd-udev-settle.service" ];
      after = [ "systemd-udev-settle.service" "network-online.target" ];

      serviceConfig = {
        Type = "notify";
        NotifyAccess = "main";
        ExecStart = "${pkgs.multipath-tools}/bin/multipathd -d -s";
        ExecReload = "${pkgs.multipath-tools}/bin/multipathd reconfigure";
        # Hardening
        LimitNOFILE = 4096;
        ProtectSystem = "full";
        ProtectHome = true;
        PrivateTmp = true;
      };
    };

    # iSCSI initiator daemon
    # NOTE: iscsid service is NOT managed by Nix due to compatibility issues
    # Managed by system package manager (apt) instead
    # See: https://github.com/wrightbradley/cloudydad-data-center/issues/XXX
    # The openiscsi package is still installed via Nix for the iscsiadm CLI tool

    # =========================================================================
    # K3S SERVICE CONFIGURATION
    # =========================================================================
    # Declarative k3s service management
    # Replaces: roles/kubernetes/k3s_server and roles/kubernetes/k3s_agent

{% if 'master' in group_names %}
    # K3s Server Configuration
    systemd.services.k3s = {
      description = "K3s Kubernetes Server";
      documentation = [ "https://k3s.io/" ];
      wantedBy = [ "multi-user.target" ];
      after = [
        "network-online.target"
        "multipathd.service"
      ];
      wants = [
        "network-online.target"
        "multipathd.service"
      ];

      path = with pkgs; [ k3s_1_32 iptables iproute2 ];

      serviceConfig = {
        Type = "exec";
        ExecStart = ''
          ${pkgs.k3s_1_32}/bin/k3s server \
            --server https://{{ apiserver_endpoint }}:6443 \
            --token-file /etc/rancher/k3s/k3s-token \
            --flannel-iface {{ flannel_iface | default('eth0') }} \
            --kubelet-arg system-reserved={{ kubelet_system_reserved | default('cpu=200m,memory=256Mi,ephemeral-storage=1Gi') }} \
            --kubelet-arg kube-reserved={{ kubelet_kube_reserved | default('cpu=200m,memory=256Mi,ephemeral-storage=512Mi') }} \
            --kubelet-arg eviction-hard={{ kubelet_eviction_hard | default('memory.available<128Mi,nodefs.available<10%') }} \
            --kubelet-arg kube-api-qps=20 \
            --kubelet-arg kube-api-burst=30
        '';
        # Service behavior
        KillMode = "process";
        Delegate = "yes";
        Restart = "always";
        RestartSec = "5s";
        TimeoutStartSec = 0;

        # Resource limits
        LimitNOFILE = "infinity";
        LimitNPROC = "infinity";
        LimitCORE = "infinity";
        TasksMax = "infinity";

        # Security hardening
        ProtectKernelTunables = false;  # k3s needs to modify sysctl
        ProtectControlGroups = false;   # k3s manages cgroups
        PrivateTmp = false;              # k3s needs shared /tmp
      };
    };
{% else %}
    # K3s Agent Configuration
    systemd.services.k3s-agent = {
      description = "K3s Kubernetes Agent";
      documentation = [ "https://k3s.io/" ];
      wantedBy = [ "multi-user.target" ];
      after = [
        "network-online.target"
        "multipathd.service"
      ];
      wants = [
        "network-online.target"
        "multipathd.service"
      ];

      path = with pkgs; [ k3s_1_32 iptables iproute2 ];

      serviceConfig = {
        Type = "exec";
        ExecStart = ''
          ${pkgs.k3s_1_32}/bin/k3s agent \
            --server https://{{ apiserver_endpoint }}:6443 \
            --token-file /etc/rancher/k3s/k3s-token \
            --flannel-iface {{ flannel_iface | default('eth0') }} \
            --kubelet-arg system-reserved={{ kubelet_system_reserved | default('cpu=200m,memory=256Mi,ephemeral-storage=1Gi') }} \
            --kubelet-arg kube-reserved={{ kubelet_kube_reserved | default('cpu=200m,memory=256Mi,ephemeral-storage=512Mi') }} \
            --kubelet-arg eviction-hard={{ kubelet_eviction_hard | default('memory.available<128Mi,nodefs.available<10%') }} \
            --kubelet-arg kube-api-qps=20 \
            --kubelet-arg kube-api-burst=30
        '';
        # Service behavior
        KillMode = "process";
        Delegate = "yes";
        Restart = "always";
        RestartSec = "5s";
        TimeoutStartSec = 0;

        # Resource limits
        LimitNOFILE = "infinity";
        LimitNPROC = "infinity";
        LimitCORE = "infinity";
        TasksMax = "infinity";

        # Security hardening
        ProtectKernelTunables = false;  # k3s needs to modify sysctl
        ProtectControlGroups = false;   # k3s manages cgroups
        PrivateTmp = false;              # k3s needs shared /tmp
      };
    };
{% endif %}

    # =========================================================================
    # SYSTEM PREREQUISITES FOR K3S
    # =========================================================================
    # Kernel parameters and modules required for Kubernetes networking
    # Replaces: roles/kubernetes/prereq (partially)

    # Kernel sysctl parameters
    boot.kernel.sysctl = {
      # IPv4 forwarding (required for pod networking)
      "net.ipv4.ip_forward" = 1;

      # IPv6 forwarding (required for dual-stack clusters)
      "net.ipv6.conf.all.forwarding" = 1;
      "net.ipv6.conf.all.accept_ra" = 2;

      # Bridge netfilter (required for kube-proxy iptables rules)
      "net.bridge.bridge-nf-call-iptables" = 1;
      "net.bridge.bridge-nf-call-ip6tables" = 1;

      # Disable swap (Kubernetes best practice)
      "vm.swappiness" = 0;
    };

    # Kernel modules
    boot.kernelModules = [
      "br_netfilter"  # Bridge netfilter support for iptables
      "overlay"       # Overlay filesystem for container images
    ];
  };
}
